<data-extraction-rules>
    <cloud-backup>
        <!-- CallScribe: Keep sensitive content and device-specific settings out of cloud backup. -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="recordings" />
        <exclude domain="file" path="models" />
        <exclude domain="external" path="recordings" />
        <exclude domain="external" path="models" />
        <!-- CallScribe: Cache directories, including partial model downloads, are never backed up. -->
    </cloud-backup>
    <device-transfer>
        <!-- CallScribe: Apply the same privacy boundary to direct device-to-device migration. -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="recordings" />
        <exclude domain="file" path="models" />
        <exclude domain="external" path="recordings" />
        <exclude domain="external" path="models" />
        <!-- CallScribe: Cache directories, including partial model downloads, are never transferred. -->
    </device-transfer>
</data-extraction-rules>