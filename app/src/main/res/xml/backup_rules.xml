<full-backup-content>
    <!-- CallScribe: Keep sensitive content and device-specific settings off backup and transfer. -->
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="recordings" />
    <exclude domain="file" path="models" />
    <exclude domain="external" path="recordings" />
    <exclude domain="external" path="models" />
    <!-- CallScribe: Cache directories, including partial model downloads, are never backed up. -->
</full-backup-content>